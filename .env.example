APP_NAME=BuildOne
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Tokyo

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# 初期版はデータベースを使用しない（セッション・キャッシュはファイル駆動）
DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- BuildOne 固有設定 ---
# YouTubeチャンネルURL（未確定の間はハンドル表示のみ）
BUILDONE_YOUTUBE_URL=
# 最新動画の埋め込みURL（未設定なら「近日公開」プレースホルダー表示）
BUILDONE_YOUTUBE_VIDEO_URL=
# 問い合わせ先（どちらか設定するとボタンが有効化。未設定なら「準備中」表示）
CONTACT_URL=
CONTACT_EMAIL=
